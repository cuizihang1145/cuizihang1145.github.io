{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/rss.xml", "destination": "/api/rss" },
    { "source": "/feed.json", "destination": "/api/feed" },
    { "source": "/atom.xml", "destination": "/api/atom" },
    { "source": "/article/:id", "destination": "/article-:id.html" }
  ]
}

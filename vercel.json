{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/article/(.*)",
      "dest": "/article/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
